{
  "name": "opencode-claude-subscription",
  "version": "0.1.0",
  "description": "OpenCode v2 plugin: use your Claude Pro/Max subscription with OpenCode's built-in Anthropic provider.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "anthropic",
    "claude",
    "oauth",
    "subscription"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "server.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/**/*.test.ts'",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.16"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.18",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
